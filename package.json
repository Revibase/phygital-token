{
  "name": "phygital-token-monorepo",
  "private": true,
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "idl:sync": "cp target/idl/phygital_token.json idl/phygital_token.json && cp target/idl/phygital_token_hook.json idl/phygital_token_hook.json",
    "generate:client": "codama run js && node clients/js/phygital-token/scripts/add-import-extensions.mjs",
    "generate:rust-client": "codama run rust && node clients/rust/phygital-token/scripts/patch-anchor-types.mjs",
    "build:client": "pnpm --filter phygital-token-sdk build",
    "build:program": "NO_DNA=1 anchor build && pnpm idl:sync && pnpm generate:client && pnpm generate:rust-client && pnpm build:client"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.2"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.0",
    "@codama/renderers-js": "^2.2.0",
    "@codama/renderers-rust": "^3.1.0",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "codama": "^1.7.0",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.9.0"
}
