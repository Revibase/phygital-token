{
  "name": "phygital-token-monorepo",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Revibase/phygital-token.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "idl:sync": "cp target/idl/phygital_token.json idl/phygital_token.json",
    "generate:sdk": "codama run js && node packages/js/phygital-token/scripts/add-import-extensions.mjs",
    "generate": "pnpm idl:sync && pnpm generate:sdk",
    "build:sdk": "pnpm --filter phygital-token-sdk build",
    "build:program": "NO_DNA=1 anchor build && pnpm generate && pnpm build:sdk"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.8.0",
    "@eslint/js": "10.0.1",
    "codama": "^1.11.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
