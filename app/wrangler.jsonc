{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "revibase",
	"compatibility_date": "2026-09-27",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": false,
	"d1_databases": [
		{
			// One D1 database. It may be shared with other services that accept the
			// same tap URLs (see migrations/README.md):
			// - tap_counters / auth_challenges: shared tables. Sharing tap_counters
			//   gives ONE counter high-water mark per chip across every service.
			// - revibase_*: this app's tables (migrations/revibase_*.sql).
			// Replace the placeholder id with your database's (`wrangler d1 create`).
			"binding": "DB",
			"database_name": "phygital-token",
			"database_id": "00000000-0000-4000-8000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"RP_ID": "revibase.com",
		"SECURE_SIGNER_ORIGIN": "https://signer.revibase.com",
		"SOLANA_CLUSTER": "mainnet",
		"SOLANA_RPC_URL": "https://rpc.revibase.com",
		// Prepaid network fees per accessory and the most the fee service signs for.
		// SPONSOR_KEYS (the fee-payer pool) is a secret: `wrangler secret put SPONSOR_KEYS`.
		"SPONSOR_PREPAID_LAMPORTS": "5000000",
		"SPONSOR_MAX_CU_LIMIT": "400000",
		"SPONSOR_MAX_CU_PRICE": "100000",
		"SPONSOR_MIN_KEY_LAMPORTS": "50000000"
	},
	"observability": { "enabled": true }
}
