{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "revibase",
	"compatibility_date": "2026-09-27",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".open-next/worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "revibase"
		}
	],
	"workers_dev": true,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "phygital-token",
			"database_id": "356d6b15-cd60-47b5-a014-648246bd27b5",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"NEXT_PUBLIC_SOLANA_CLUSTER": "mainnet",
		"NEXT_PUBLIC_SOLANA_RPC_URL": "https://rpc.revibase.com",
		"NEXT_PUBLIC_PRIVY_APP_ID": "cmqt76oza019h0ck6296p44a8"
	},
	"observability": { "enabled": true }
}
