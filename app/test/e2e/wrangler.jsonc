// Bindings for the local end-to-end stack only (`pnpm e2e:setup`, then
// REVIBASE_PLATFORM=e2e vite dev, over HTTPS). Its own D1 store under .wrangler/e2e and
// its own secrets in test/e2e/.dev.vars, written by the setup script, so the
// e2e run never touches your normal .dev.vars or local database.
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "revibase-e2e",
	"compatibility_date": "2026-09-27",
	"compatibility_flags": ["nodejs_als"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "phygital-token-e2e",
			"database_id": "00000000-0000-4000-8000-000000000000",
			"migrations_dir": "../../migrations"
		}
	],
	"vars": {
		"RP_ID": "localhost",
		"SECURE_SIGNER_ORIGIN": "https://localhost:5174",
		"SOLANA_CLUSTER": "localnet",
		"SOLANA_RPC_URL": "https://localhost:5173/__e2e/rpc",
		"SPONSOR_PREPAID_LAMPORTS": "5000000",
		"SPONSOR_MAX_CU_LIMIT": "400000",
		"SPONSOR_MAX_CU_PRICE": "100000",
		"SPONSOR_MIN_KEY_LAMPORTS": "50000000"
	}
}
