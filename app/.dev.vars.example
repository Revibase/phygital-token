# Copy to .dev.vars for `vite dev` / `wrangler dev`.
# A public RPC endpoint that also serves DAS (getAsset). The browser calls it directly,
# so it must be a proxy Worker with no secret in the URL.
SOLANA_RPC_URL=https://your-rpc-proxy.example.com
SESSION_SECRET=replace-me
# Handoff and pairing links point here; use the dev server's URL locally.
ORIGIN=http://localhost:5173
# The WebAuthn relying party: the host that serves the tap page.
RP_ID=localhost
