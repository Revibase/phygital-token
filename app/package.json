    "@solana/web3.js": "^1.98.4",
    "@walletconnect/universal-provider": "^2.23.9",
    "crypto-browserify": "^3.12.1",
    "phygital-nfts-client": "file:../clients/js",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "stream-browserify": "^3.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "buffer": "^6.0.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.3",
