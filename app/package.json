{
	"name": "revibase",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "pnpm build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check --env-file .dev.vars.example && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types --env-file .dev.vars.example",
		"test:unit": "vitest",
		"test": "vitest --run",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.59.0",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/qrcode": "^1.5.6",
		"bits-ui": "^2.19.5",
		"cn": "^0.5.0",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"dependencies": {
		"@noble/curves": "catalog:",
		"@noble/hashes": "catalog:",
		"@solana-mobile/wallet-standard-mobile": "^0.7.0",
		"@solana-program/compute-budget": "^0.20.0",
		"@solana-program/system": "^0.16.0",
		"@solana-program/token": "^0.18.0",
		"@solana/connector": "^0.3.0",
		"@solana/kit": "^8.5.0",
		"@solana/wallet-standard-features": "^1.5.0",
		"@tanstack/query-sync-storage-persister": "^5.104.3",
		"@tanstack/svelte-query": "^6.3.3",
		"@tanstack/svelte-query-persist-client": "^6.3.4",
		"@wallet-standard/app": "^1.1.1",
		"@wallet-standard/base": "^1.1.1",
		"phygital-token-sdk": "workspace:*",
		"qrcode": "^1.5.4",
		"revibase-wallet-sdk": "^0.1.0"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
