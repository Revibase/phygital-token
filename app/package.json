{
	"name": "revibase",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"test:unit": "vitest",
		"test": "vitest --run",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"e2e:local": "tsx scripts/e2e-local.ts",
		"dev:accessory": "tsx scripts/dev-accessory.ts"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@solana-program/system": "^0.15.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/qrcode": "^1.5.6",
		"bits-ui": "^2.19.3",
		"cn": "^0.4.0",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@noble/curves": "^2.3.0",
		"@noble/hashes": "^2.4.0",
		"@solana-mobile/wallet-standard-mobile": "^0.5.3",
		"@solana-program/compute-budget": "^0.19.0",
		"@solana/connector": "^0.2.6",
		"@solana/kit": "^8.3.0",
		"@solana/wallet-standard-features": "^1.5.0",
		"@tanstack/query-sync-storage-persister": "^5.104.0",
		"@tanstack/svelte-query": "^6.3.0",
		"@tanstack/svelte-query-persist-client": "^6.3.0",
		"@wallet-standard/base": "^1.1.1",
		"@wallet-standard/features": "^1.1.0",
		"phygital-token-sdk": "workspace:*",
		"qrcode": "^1.5.4"
	}
}
