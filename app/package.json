{
	"name": "revibase",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "next dev --port 5173",
		"build": "opennextjs-cloudflare build",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"gen": "wrangler types --env-file .dev.vars.example",
		"check": "wrangler types --check --env-file .dev.vars.example && tsc --noEmit",
		"test": "vitest --run",
		"test:unit": "vitest",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@noble/curves": "catalog:",
		"@opennextjs/cloudflare": "^1.19.11",
		"@privy-io/react-auth": "^3.20.0",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@solana-mobile/wallet-standard-mobile": "^0.7.0",
		"@solana-program/compute-budget": "^0.20.0",
		"@solana-program/memo": "^0.16.0",
		"@solana-program/system": "^0.16.0",
		"@solana-program/token": "^0.18.0",
		"@solana/kit": "^8.5.0",
		"@solana/wallet-standard-features": "^1.5.0",
		"@tanstack/query-sync-storage-persister": "^5.104.3",
		"@tanstack/react-query": "^5.100.9",
		"@tanstack/react-query-persist-client": "^5.100.9",
		"lucide-react": "^1.8.0",
		"next": "^16.2.4",
		"phygital-token-sdk": "workspace:*",
		"qrcode": "^1.5.4",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "^2.0.7",
		"tailwind-variants": "^3.3.1",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@noble/hashes": "catalog:",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "catalog:",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"cn": "^0.5.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
