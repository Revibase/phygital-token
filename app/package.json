{
  "name": "phygital-nfts-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "predev": "npm run build --prefix ../clients/js",
    "build": "vite build",
    "prebuild": "npm run build --prefix ../clients/js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
