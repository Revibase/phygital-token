# Solana RPC endpoint (defaults to devnet)
PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# WalletConnect Cloud project ID (required for wallet signing on desktop and mobile)
# Create one at https://cloud.walletconnect.com
PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arweave gateway used for metadata and image URLs (keep short for on-chain URI limit)
PUBLIC_ARWEAVE_GATEWAY=https://arweave.net
