{
  "printWidth": 100,
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    {
      "files": "app/**",
      "options": {
        "useTabs": true,
        "singleQuote": true,
        "trailingComma": "none"
      }
    },
    {
      "files": "*.svelte",
      "options": { "parser": "svelte" }
    }
  ]
}
