{
  "name": "phygital-token-mcp",
  "version": "1.0.3",
  "description": "MCP server for the phygital-token Solana program, TypeScript SDK, and Rust client",
  "license": "MIT",
  "author": "Revibase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Revibase/phygital-token.git",
    "directory": "mcp/phygital-token"
  },
  "homepage": "https://github.com/Revibase/phygital-token/tree/master/mcp/phygital-token",
  "bugs": {
    "url": "https://github.com/Revibase/phygital-token/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "phygital",
    "webauthn",
    "nft"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "phygital-token-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "cursor-mcp.example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/add-shebang.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "pnpm build",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@solana/kit": "^8.0.0",
    "phygital-token-sdk": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
