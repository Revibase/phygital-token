{
  "name": "phygital-token-sdk",
  "version": "1.10.0",
  "description": "TypeScript client for the Phygital Token Solana program",
  "license": "MIT",
  "author": "Revibase",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Revibase/phygital-token.git",
    "directory": "packages/js/phygital-token"
  },
  "homepage": "https://github.com/Revibase/phygital-token/tree/master/packages/js/phygital-token",
  "bugs": {
    "url": "https://github.com/Revibase/phygital-token/issues"
  },
  "keywords": [
    "solana",
    "phygital",
    "webauthn",
    "nft",
    "passkey"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.json",
    "api:check": "pnpm build && api-extractor run",
    "api:update": "pnpm build && api-extractor run --local"
  },
  "peerDependencies": {
    "@solana/kit": "^8.3.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
    "@solana/kit": "^8.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@solana/wallet-standard-chains": "^1.1.2",
    "@solana/wallet-standard-features": "^1.5.0",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@wallet-standard/wallet": "^1.1.1"
  }
}
