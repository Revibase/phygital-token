{
  "idl": "idl/phygital_token.json",
  "before": [],
  "scripts": {
    "js": {
      "from": "@codama/renderers-js",
      "args": [
        "clients/js/phygital-token",
        {
          "formatCode": true,
          "syncPackageJson": true,
          "kitImportStrategy": "rootOnly",
          "dependencyVersions": {
            "@solana/kit": "^6.4.0"
          }
        }
      ]
    },
    "rust": {
      "from": "@codama/renderers-rust",
      "args": [
        "clients/rust/phygital-token",
        {
          "generatedFolder": "src/generated"
        }
      ]
    }
  }
}
